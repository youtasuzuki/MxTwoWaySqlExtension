<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MxTwoWaySqlExtension</AssemblyName>
    <RootNamespace>MxTwoWaySqlExtension</RootNamespace>
    <!-- Mendix SDK由来の既知の推移的パッケージ警告を無視 -->
    <NoWarn>$(NoWarn);NU1902</NoWarn>
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mendix.StudioPro.ExtensionsAPI" Version="10.24.*" />
  </ItemGroup>
  
  <ItemGroup>
    <None Update="extension.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
